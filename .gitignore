# Godot 4+ specific ignores
.godot/
.godot_user/
/android/

# Local check logs
*.log

# Python tool caches and local art processing previews
__pycache__/
*.pyc
tools/art_test_output/

# Godot-generated import byproducts for processed asset manifests
assets/processed/**/*.csv.import
assets/processed/**/*.translation

# Local editor/agent settings
.claude/
.vscode/
